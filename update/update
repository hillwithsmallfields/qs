#!/bin/bash

SCRIPT_DIR=$(dirname $(readlink -f "$0"))

source $SCRIPT_DIR/../qs.env/bin/activate

export ARCHIVE=$HOME/archive
export DOWNLOADS=$HOME/Downloads
export ISOS=$HOME/isos
export PRIVATEHTML=$HOME/private_html
export SCRATCH=$HOME/scratch
export SYNCEDBACKUPS=$HOME/Sync-snapshots


# currently 3.12 on noticeboard:
PYTHON=python3
case $(hostname) in
    shtogu)
        # has pandas on noticeboard:
        PYTHON=python3.10
        ;;
esac

$PYTHON $SCRIPT_DIR/update.py $*
